# openGym configuration — copy to .env and adjust for your deployment:
#   cp .env.example .env
# All values below are the defaults; for local use you can leave them as-is.

# Hostname passkeys are bound to (your domain when self-hosting, e.g. gym.example.com)
RP_ID=localhost

# Full URL the app is served from (e.g. https://gym.example.com)
ORIGIN=http://localhost:8080

# Host port for the web UI
WEB_PORT=8080

# Name shown in the passkey prompt
RP_NAME=openGym

# User ids that get the admin dashboard (comma-separated)
ADMIN_UIDS=

# Require an invite code to create a profile (1/true/yes/on to enable)
INVITE_ONLY=

# --- Optional ---

# How long a session cookie lasts, in days
#SESSION_DAYS=90

# Contact for push notifications (mailto: or https: URL); defaults to ORIGIN on https
#VAPID_SUBJECT=
